# Local editor and agent scratch state
.idea/
.agents/

# Prerequisites
*.d

# ALSA UCM uses conf.d as a real configuration directory, not a dependency file.
!alsa/ucm2/conf.d/
!alsa/ucm2/conf.d/**

# Backend-selection templates are modprobe configuration, not dependency files.
!driver/modprobe.d/
!driver/modprobe.d/**

# Python cache files
__pycache__/
*.py[cod]

# Object files
*.o
*.ko
*.obj
*.elf

# Linker output
*.ilk
*.map
*.exp

# Precompiled Headers
*.gch
*.pch

# Libraries
*.lib
*.a
*.la
*.lo

# Shared objects (inc. Windows DLLs)
*.dll
*.so
*.so.*
*.dylib

# Executables
*.exe
*.out
*.app
*.i*86
*.x86_64
*.hex

# Debug files
*.dSYM/
*.su
*.idb
*.pdb

# Kernel Module Compile Results
*.mod*
*.cmd
.tmp_versions/
modules.order
Module.symvers
Mkfile.old
dkms.conf

# Pinned upstream source is fetched outside the repository. This ignored
# symlink is only the Kbuild bridge to that external cache.
driver/.upstream-src

# debug information files
*.dwo

# Large trace files (exceed GitHub 100MB limit)
*.etl
scripts/trace_analysis/*.csv
trace_analysis/*.csv

# Ghidra install and generated project state (scripts/setup_ghidra_linux.sh)
tools/
*.gpr
*.rep/
*.lock
*.ulock
!driver/upstream.lock

# Generated trace-analysis output; retain conclusions under notes/ instead
scripts/trace_analysis/*.txt

# driver-reference: copyrighted PreSonus/Windows files only (not .txt, etc.)
driver-reference/pae_quantum.sys
driver-reference/pae_quantum.inf
driver-reference/pae_quantum.cat
driver-reference/pae_quantum.PNF
